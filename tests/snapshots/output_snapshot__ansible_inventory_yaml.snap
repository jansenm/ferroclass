      _reclass_:
        environment: base
        name:
          full: app-staging-01
          short: app-staging-01
      global:
        admin:
          email: admin@example.com
        timezone: UTC
      environment_name: staging
      log_level: debug
      role: web
      webserver:
        port: 80
        ssl: true
      app:
        name: myapp
